{:paths ["src" "resources"]
 :deps {org.clojure/clojure {:mvn/version "1.12.4"}
        cheshire/cheshire {:mvn/version "5.13.0"}
        ;; sibling gftdcojp repo, local/root dep (same pattern as cloud-itonami's
        ;; io.github.gftdcojp/cloud-mamori dependency) — reuse the already-proven
        ;; job normalization + kotoba-queue submit/poll wire protocol instead of
        ;; re-deriving it here.
        io.github.gftdcojp/cloud-murakumo {:local/root "../../network-awai/cloud-murakumo"}
        ;; ed25519 を **この repo の直接依存として明示する**。理由は座標の二重化:
        ;; cloud-murakumo は io.github.kotoba-lang/ed25519 を :local/root
        ;; （改名後の org-ietf-ed25519 を指す）で持ち、その依存先の
        ;; kotoba-lang/murakumo は同じ lib 名を :git/sha で持っている。
        ;; cloud-murakumo 単体では自分の top-level 宣言が勝つので解決するが、
        ;; ここから consume すると両方が推移依存に落ちて tools.deps が
        ;; 「Unable to compare versions」で classpath を組めなくなる
        ;; （実測: この repo の suite は無改変の main でも 1 度も走っていなかった）。
        ;; top-level に置けば深さ 1 で勝つ。cloud-murakumo 自身と同じ形。
        io.github.kotoba-lang/ed25519 {:local/root "../../kotoba-lang/org-ietf-ed25519"}}
 :aliases
 {:run {:main-opts ["-m" "audio.main"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd"}}
         :main-opts ["-m" "cognitect.test-runner"]
         :exec-fn cognitect.test-runner.api/test}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main"
                        "--lint" "src" "test"
                        "--fail-level" "error"]}}}
